{
  // Typecheck des tests, exécutés dans Node (vitest).
  //
  // Ce fichier n'extends PAS `tsconfig.json` à dessein : `extends` y HERITE du
  // tableau `include`, et le typecheck des tests se retrouvait donc à compiler
  // tout `src/` avec les types Node — donc sans `@cloudflare/workers-types`, et
  // `BufferSource` (utilisé par src/routes/auth.ts) devenait introuvable.
  // Les options sont donc répétées ici, volontairement.
  //
  // Les deux séries de types coexistent : `node` pour `node:fs` et
  // `import.meta.url` (le test de parité d'identité lit des fichiers du dépôt),
  // `workers-types` pour ce que `src/` attend. Cette fuite n'a pas lieu d'être
  // ici, contrairement au build du Worker — voir le commentaire de tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "workers-env.d.ts"]
}
